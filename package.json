{
  "name": "scrollsequence-examples-workspace",
  "version": "2.0.0-beta.53",
  "private": true,
  "type": "module",
  "description": "Scrollsequence interactive examples and showcase repository",
  "workspaces": [
    "react",
    "vanilla"
  ],
  "scripts": {
    "dev:react": "npm --prefix react run dev",
